    import re
    import unicodedata

    def codex_markup(text):

        aliases = sorted(ALIASES.items(), key=lambda x: len(x[0]), reverse=True)

        for phrase, key in aliases:

            pattern = r'(?<!\\w){}(?!\\w)'.format(re.escape(phrase))

            replacement = "{a=codex:%s}%s{/a}" % (key, phrase)

            text = re.sub(pattern, replacement, text)

        return text

    # These are deliberately separate from the broader ALIASES table: only
    # requested codex names are automatically linked in event dialogue.
    DIALOGUE_CODEX_ALIASES = {
        "Zichy Hoovitz": "zichy_hoovitz",
        "Zichy": "zichy_hoovitz",
        "Józiff Ivanothy": "joziff_ivanothy",
        "Prince-Regent Józiff Ivanothy": "joziff_ivanothy",
        "Józiff": "joziff_ivanothy",
        "Solène Lapis": "solene_lapis",
        "Queen Solène Lapis": "solene_lapis",
        "Solène": "solene_lapis",
        "Isine fue Tholedo": "isine_tholedo",
        "Isine": "isine_tholedo",
        "Robertz fue Tholedo": "robertz_tholedo",
        "Robertz": "robertz_tholedo",
        "Charristo fue Tholedo": "charristo_tholedo",
        "Charristo": "charristo_tholedo",
        "Maté fue Tholedo": "mate_tholedo",
        "Maté": "mate_tholedo",
        "Cálitz fue Tholedo": "calitz_tholedo",
        "Cálitz": "calitz_tholedo",
        "Sicill fue Tholedo": "sicill_tholedo",
        "Princess Sicill": "sicill_tholedo",
        "Empress Sicill": "sicill",
        "Sicill": "sicill",
        "Quixote fue Ostamara": "quixote",
        "Quixote": "quixote",
        "Furique Vallitu": "furique",
        "Furique": "furique",
        "Torrez fue Léon": "torrez",
        "Torrez": "torrez",
        "Aurgenbia Panzarre": "aurgenbia",
        "Aurgenbia": "aurgenbia",
        "Gaucho fue Léon": "gaucho",
        "Gaucho": "gaucho",
    }
    DIALOGUE_CODEX_PATTERN = re.compile(
        r'(?<!\w)(?:Zichy\ Hoovitz|Prince-Regent\ Józiff\ Ivanothy|Józiff\ Ivanothy|Queen\ Solène\ Lapis|Quixote\ fue\ Ostamara|Furique\ Vallitu|Torrez\ fue\ Léon|Aurgenbia\ Panzarre|Gaucho\ fue\ Léon|Robertz\ fue\ Tholedo|Charristo\ fue\ Tholedo|Maté\ fue\ Tholedo|Cálitz\ fue\ Tholedo|Isine\ fue\ Tholedo|Solène\ Lapis|Sicill\ fue\ Tholedo|Princess\ Sicill|Empress\ Sicill|Zichy|Józiff|Quixote|Furique|Torrez|Aurgenbia|Gaucho|Robertz|Charristo|Maté|Cálitz|Isine|Solène|Sicill)(?!\w)'
    )
    DIALOGUE_POSSESSIVE_PATTERN = re.compile(
        r"(?<!\w)(%s)\s+(['’]s)\b" % "|".join(
            re.escape(alias) for alias in sorted(DIALOGUE_CODEX_ALIASES, key=len, reverse=True)
        )
    )
    DIALOGUE_LINK_SPLIT_PATTERN = re.compile(r"(\{a=[^}]+\}.*?\{/a\})", re.DOTALL)
    CODEX_HYPERLINK_PATTERN = re.compile(r"(\{a=codex(?:_name)?:[^}]+\})(.*?)(\{/a\})")

    def dialogue_codex_markup(text):
        """Turn requested character names in dialogue into codex links."""

        # Normalize accents so names match regardless of whether the source
        # text uses composed characters (è) or decomposed characters (e + ◌̀).
        text = unicodedata.normalize("NFC", text)

        # Keep possessives attached to the linked name, even if a script line
        # contains accidental whitespace before 's or ’s.
        text = DIALOGUE_POSSESSIVE_PATTERN.sub(r"\1\2", text)

        def link_alias(match):
            phrase = match.group(0)
            return "{a=codex_name:%s}%s{/a}" % (DIALOGUE_CODEX_ALIASES[phrase], phrase)

        # Preserve any explicit hyperlink markup, such as Solène's speaker
        # name, and only auto-link plain text outside existing links.
        parts = DIALOGUE_LINK_SPLIT_PATTERN.split(text)
        for i in range(0, len(parts), 2):
            parts[i] = DIALOGUE_CODEX_PATTERN.sub(link_alias, parts[i])

        return "".join(parts)

    def narrator_codex_markup(text):
        """Keep codex links italic when they appear inside narration."""
        return CODEX_HYPERLINK_PATTERN.sub(r"\1{i}\2{/i}\3", text)

    # Apply the markup before Ren'Py hands dialogue to the say screen. This
    # keeps the screen's `what` displayable identical to the dialogue value.
    config.say_menu_text_filters.append(dialogue_codex_markup)
